<div id="llm-chat" phx-hook="LlmSSE" class="min-h-screen bg-base-100 text-base-content">
  <div class=" max-w-7xl mx-auto p-4 lg:p-6">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
      <div>
        <div class="flex flex-1 items-center gap-3">
          <h1 class="text-2xl lg:text-3xl font-bold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
            Plan Execute
          </h1>

          <span class="badge badge-success badge-lg">
            <span class="inline-block w-2 h-2 bg-success rounded-full mr-1"></span> Active
          </span>
        </div>

        <div class="text-sm text-base-content/70 mt-2">
          <span class="font-medium">Conversation:</span>
          <span class="font-mono ml-2 bg-base-200 px-2 py-1 rounded">
            <%= if @conversation_id && @conversation_id != "new" do %>
              {@conversation_id}
            <% else %>
              New Conversation
            <% end %>
          </span>
          <a
            class="ml-4 text-primary hover:text-primary-focus transition-colors"
            href={~p"/conversations"}
          >
            ↗ View Conversations
          </a>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <a
          href={~p"/conversations"}
          class="btn btn-outline btn-neutral"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
            />
          </svg>
          Conversations
        </a>
      </div>
    </div>
    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Left Panel: Configuration -->
      <div class=" lg:col-span-1 space-y-4">
        <!-- Execution Form -->
        <div class="bg-base-200/50 backdrop-blur-sm border border-base-300 rounded-box p-5">
          <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <svg
              class="w-5 h-5 text-primary"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              />
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              />
            </svg>
            Configuration
          </h3>

          <form phx-submit="execute" class="space-y-4">
            <!-- Agent Selection -->
            <label class="text-sm text-slate-300">Agent</label>
            <select
              name="agent_id"
              phx-change="select_agent"
              class="select select-bordered w-full"
            >
              <%= for a <- @agents do %>
                <option value={a.id} selected={a.id == @agent_id}>
                  {a.name || a.id} (v{a.version})
                </option>
              <% end %>
            </select>
            <!-- Profile Selection -->
            <div>
              <label class="label"><span class="label-text">Profile</span></label>
              <select name="profile_id" class="select select-bordered w-full">
                <%= for p <- @profiles do %>
                  <option value={p.id} selected={@profile_id == p.id}>
                    {p.name || p.id} {if !p.enabled, do: " (disabled)", else: ""}
                  </option>
                <% end %>
              </select>
            </div>
            <!-- Conversation Selection -->
            <div class="space-y-4">
              <!-- Conversation Select -->
              <div>
                <label class="label"><span class="label-text">Conversation</span></label>
                <select name="conversation_id" class="select select-bordered w-full">
                  <option value="new" selected={@conversation_id == "new" or !@conversation_id}>
                    New Conversation
                  </option>

                  <%= for c <- (@conversations || []) do %>
                    <option value={c.id} selected={c.id == @conversation_id}>
                      {c.name || c.id}
                    </option>
                  <% end %>
                </select>
                <label class="label">
                  <span class="label-text-alt">
                    Select an existing conversation or create a new one
                  </span>
                </label>
              </div>
              <!-- New Conversation Button -->
              <div class="pt-2">
                <button type="button" phx-click="new_conversation" class="btn btn-outline w-full">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 4v16m8-8H4"
                    />
                  </svg>
                  New Conversation
                </button>
                <label class="label">
                  <span class="label-text-alt text-center w-full">
                    Creates a fresh conversation with a unique ID
                  </span>
                </label>
              </div>
            </div>
            <!-- Prompt Area -->
            <div>
              <label class="label">
                <span class="label-text">Prompt</span>
                <span class="label-text-alt">Markdown supported</span>
              </label> <textarea
                name="prompt"
                rows="10"
                class="textarea textarea-bordered w-full font-mono text-sm"
                placeholder="Enter your prompt here..."
              ><%= @prompt %></textarea>
            </div>
            <!-- Execute Button -->
            <button type="submit" class="btn btn-primary w-full" disabled={@loading or @streaming}>
              <div class="flex items-center justify-center gap-2">
                <%= if @streaming do %>
                  <span class="loading loading-spinner loading-sm"></span> Streaming...
                <% else %>
                  <%= if @loading do %>
                    <span class="loading loading-spinner loading-sm"></span> Executing...
                  <% else %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                    Execute Plan
                  <% end %>
                <% end %>
              </div>
            </button>
          </form>

          <%= if @error do %>
            <div class="alert alert-error mt-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <div>
                <h3 class="font-semibold">Execution Error</h3>
                 <pre class="text-sm whitespace-pre-wrap"><%= inspect(@error, pretty: true) %></pre>
              </div>
            </div>
          <% end %>
        </div>
        <!-- Quick Stats -->
        <div class="bg-base-200/50 backdrop-blur-sm border border-base-300 rounded-box p-5">
          <h3 class="text-lg font-semibold mb-4">Session Info</h3>

          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-base-content/70">Messages</span>
              <span class="font-semibold">{length(@messages)}</span>
            </div>

            <div class="flex justify-between items-center">
              <span class="text-base-content/70">Status</span>
              <span class={["badge", if(@streaming, do: "badge-success", else: "badge-neutral")]}>
                {if @streaming, do: "Streaming", else: "Ready"}
              </span>
            </div>

            <div class="flex justify-between items-center">
              <span class="text-base-content/70">Current Conversation</span>
              <span class="font-medium text-sm truncate max-w-[120px]">
                <%= if @conversation_id && @conversation_id != "new" do %>
                  {@conversation_id}
                <% else %>
                  New
                <% end %>
              </span>
            </div>
          </div>
        </div>
      </div>
      <!-- Right Panel: Conversation -->
      <div class="lg:col-span-2 flex flex-col">
        <div class="bg-base-200/50 backdrop-blur-sm border border-base-300 rounded-box overflow-hidden flex-1 flex flex-col">
          <!-- Conversation Header -->
          <div class="p-5 border-b border-base-300">
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-semibold flex items-center gap-2">
                <svg
                  class="w-5 h-5 text-primary"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
                  />
                </svg>
                Conversation
                <%= if @conversation_id && @conversation_id != "new" do %>
                  <span class="text-sm font-normal text-base-content/70">
                    ({@conversation_id})
                  </span>
                <% end %>
              </h3>

              <div class="flex items-center gap-2">
                <%= if @conversation_id && @conversation_id != "new" do %>
                  <a
                    href={~p"/conversations/#{@conversation_id}"}
                    class="btn btn-ghost btn-sm"
                    title="Open in Chat"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
                      />
                    </svg>
                  </a>
                <% end %>

                <button
                  class="btn btn-ghost btn-sm"
                  title="Clear Conversation"
                  phx-click="clear_messages"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                    />
                  </svg>
                </button>
              </div>
            </div>
          </div>
          <!-- Messages Container -->
          <.messages
            messages={@messages}
            streaming={@streaming}
            stream_buffer={@stream_buffer}
            conversation_id={@conversation_id}
          />
          <!-- Results Panel -->
          <%= if @result do %>
            <.results
              result={@result}
              conversation_id={@conversation_id}
            />
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
