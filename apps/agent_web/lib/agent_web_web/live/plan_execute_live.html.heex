<div id="llm-chat" phx-hook="LlmSSE" class="min-h-screen bg-slate-900 text-slate-100">
    <div class="max-w-7xl mx-auto p-4 lg:p-6">
    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
        <div>
        <div class="flex items-center gap-3">
            <h1 class="text-2xl lg:text-3xl font-bold bg-gradient-to-r from-indigo-400 to-purple-400 bg-clip-text text-transparent">
            Plan Execute
            </h1>

            <span class="px-2 py-1 text-xs bg-slate-800 border border-slate-700 rounded-full">
            <span class="inline-block w-2 h-2 bg-green-500 rounded-full mr-1"></span> Active
            </span>
        </div>

        <div class="text-sm text-slate-400 mt-2">
            <span class="font-medium">Trace ID:</span>
            <span class="font-mono ml-2 bg-slate-800 px-2 py-1 rounded">{@trace_id}</span>
            <a
            class="ml-4 text-indigo-400 hover:text-indigo-300 transition-colors"
            href={~p"/runs?trace_id=#{@trace_id}"}
            >
            ↗ View History
            </a>
        </div>
        </div>

        <div class="flex items-center gap-4">
        <a
            href={~p"/runs"}
            class="flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
            />
            </svg>
            History
        </a>
        </div>
    </div>
    <!-- Progress Steps -->
    <div class="mb-6 bg-slate-800/50 backdrop-blur-sm border border-slate-700 rounded-xl p-4 lg:p-6">
        <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold flex items-center gap-2">
            <svg
            class="w-5 h-5 text-indigo-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
            />
            </svg>
            Execution Plan
        </h2>
            <span class="text-xs text-slate-400 bg-slate-900 px-2 py-1 rounded">2 steps</span>
        </div>

        <div class="relative">
        <!-- Progress line -->
        <div class="absolute top-6 left-4 right-4 h-0.5 bg-slate-700 z-0"></div>

        <div class="absolute top-6 left-4 w-1/2 h-0.5 bg-gradient-to-r from-indigo-500 to-purple-500 z-10">
        </div>

        <div class="flex justify-between relative z-20">
            <!-- Step 1 -->
            <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-600 to-purple-600 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"
                />
                </svg>
            </div>
                <span class="mt-3 font-medium">Analysis</span>
            <span class="text-xs text-slate-400 mt-1">Completed</span>
            </div>
            <!-- Step 2 -->
            <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-slate-700 border-2 border-slate-600 flex items-center justify-center">
                <span class="font-semibold">2</span>
            </div>
                <span class="mt-3 font-medium">Execution</span>
            <span class="text-xs text-slate-400 mt-1">In Progress</span>
            </div>
            <!-- Step 3 -->
            <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full bg-slate-800/50 border-2 border-slate-700 flex items-center justify-center">
                <span class="font-semibold text-slate-500">3</span>
            </div>
                <span class="mt-3 font-medium text-slate-400">Review</span>
            <span class="text-xs text-slate-500 mt-1">Pending</span>
            </div>
        </div>
        </div>
    </div>
    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Panel: Configuration -->
        <div class="lg:col-span-1 space-y-6">
        <!-- Execution Form -->
        <div class="bg-slate-800/50 backdrop-blur-sm border border-slate-700 rounded-xl p-5">
            <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <svg
                class="w-5 h-5 text-indigo-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                />
                <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                />
            </svg>
            Configuration
            </h3>

            <form phx-submit="execute" class="space-y-4">
            <!-- Profile Selection -->
            <div>
                <label class="block text-sm font-medium mb-2 text-slate-300">Profile</label>
                <div class="relative">
                <select
                    name="profile_id"
                    class="w-full px-4 py-3 rounded-lg bg-slate-900 border border-slate-700 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all appearance-none"
                >
                    <%= for p <- @profiles do %>
                    <option value={p.id} selected={@profile_id == p.id}>
                        {p.name || p.id} {if !p.enabled, do: " (disabled)", else: ""}
                    </option>
                    <% end %>
                </select>
                <div class="absolute right-3 top-1/2 transform -translate-y-1/2 pointer-events-none">
                    <svg
                    class="w-5 h-5 text-slate-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                    />
                    </svg>
                </div>
                </div>
            </div>
            <!-- Trace ID & Phase -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div>
                <label class="block text-sm font-medium mb-2 text-slate-300">Trace ID</label>
                <input
                    name="trace_id"
                    value={@trace_id}
                    class="w-full px-4 py-3 rounded-lg bg-slate-900 border border-slate-700 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all"
                    placeholder="Auto-generated"
                />
                <p class="text-xs text-slate-500 mt-1">Leave empty for auto-generation</p>
                </div>

                <div>
                <label class="block text-sm font-medium mb-2 text-slate-300">Phase</label>
                <div class="relative">
                    <select
                    name="phase"
                    class="w-full px-4 py-3 rounded-lg bg-slate-900 border border-slate-700 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all appearance-none"
                    >
                    <option value="" selected={@phase == ""}>Select phase</option>

                    <option value="draft" selected={@phase == "draft"}>Draft</option>

                    <option value="critique" selected={@phase == "critique"}>Critique</option>

                    <option value="revise" selected={@phase == "revise"}>Revise</option>

                    <option value="final" selected={@phase == "final"}>Final</option>
                    </select>
                    <div class="absolute right-3 top-1/2 transform -translate-y-1/2 pointer-events-none">
                    <svg
                        class="w-5 h-5 text-slate-400"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                        />
                    </svg>
                    </div>
                </div>
                </div>
            </div>
            <!-- Prompt Area -->
            <div>
                <div class="flex justify-between items-center mb-2">
                <label class="block text-sm font-medium text-slate-300">Prompt</label>
                <span class="text-xs text-slate-500">Markdown supported</span>
                </div>
                <textarea
                name="prompt"
                rows="10"
                class="w-full px-4 py-3 rounded-lg bg-slate-900 border border-slate-700 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all font-mono text-sm resize-none"
                placeholder="Enter your prompt here..."
                ><%= @prompt %></textarea>
            </div>
            <!-- Execute Button -->
            <button
                type="submit"
                class="w-full px-6 py-3 rounded-lg bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 disabled:opacity-50 disabled:cursor-not-allowed font-medium transition-all transform hover:scale-[1.02] active:scale-[0.98] shadow-lg shadow-indigo-500/20"
                disabled={@loading or @streaming}
            >
                <div class="flex items-center justify-center gap-2">
                <%= if @streaming do %>
                    <svg
                    class="w-5 h-5 animate-spin"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    />
                    </svg>
                    Streaming...
                <% else %>
                    <%= if @loading do %>
                    <svg
                        class="w-5 h-5 animate-spin"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                        />
                    </svg>
                    Executing...
                    <% else %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                        />
                        <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        />
                    </svg>
                    Execute Plan
                    <% end %>
                <% end %>
                </div>
            </button>
            </form>

            <%= if @error do %>
            <div class="mt-4 p-4 rounded-lg border border-red-500/40 bg-red-950/30">
                <div class="flex items-center gap-2 text-red-400 font-semibold mb-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                </svg>
                Execution Error
                </div>
                <pre class="text-sm whitespace-pre-wrap text-red-300"><%= inspect(@error, pretty: true) %></pre>
            </div>
            <% end %>
        </div>
        <!-- Quick Stats -->
        <div class="bg-slate-800/50 backdrop-blur-sm border border-slate-700 rounded-xl p-5">
            <h3 class="text-lg font-semibold mb-4">Session Info</h3>

            <div class="space-y-3">
            <div class="flex justify-between items-center">
                <span class="text-slate-400">Messages</span>
                <span class="font-semibold">{length(@messages)}</span>
            </div>

            <div class="flex justify-between items-center">
                <span class="text-slate-400">Status</span>
                <span class="px-2 py-1 text-xs rounded-full bg-green-900/30 text-green-400">
                {if @streaming, do: "Streaming", else: "Ready"}
                </span>
            </div>

            <div class="flex justify-between items-center">
                <span class="text-slate-400">Last Updated</span>
                <span class="font-medium">Just now</span>
            </div>
            </div>
        </div>
        </div>
        <!-- Right Panel: Conversation -->
        <div class="lg:col-span-2 flex flex-col">
        <div class="bg-slate-800/50 backdrop-blur-sm border border-slate-700 rounded-xl overflow-hidden flex-1 flex flex-col">
            <!-- Conversation Header -->
            <div class="p-5 border-b border-slate-700">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold flex items-center gap-2">
                <svg
                    class="w-5 h-5 text-indigo-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
                    />
                </svg>
                Conversation
                </h3>

                <div class="flex items-center gap-2">
                <button class="p-2 rounded-lg hover:bg-slate-700 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                    />
                    </svg>
                </button>
                <button class="p-2 rounded-lg hover:bg-slate-700 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                    />
                    </svg>
                </button>
                </div>
            </div>
            </div>
            <!-- Messages Container -->
            <div class="flex-1 overflow-y-auto max-h-[calc(100vh-320px)]">
            <div class="p-5 space-y-4">
                <%= for m <- @messages do %>
                <div class={bubble_class(m["role"])}>
                    <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-2">
                        <span class={role_icon_class(m["role"])}>{role_icon(m["role"])}</span>
                        <span class="text-sm font-semibold capitalize">{m["role"]}</span>
                        <span class="text-xs text-slate-500">
                        {if m["timestamp"], do: m["timestamp"], else: "Just now"}
                        </span>
                    </div>

                    <button class="p-1 hover:bg-slate-700 rounded transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"
                        />
                        </svg>
                    </button>
                    </div>

                    <div class="prose prose-invert max-w-none">
                    <pre class="whitespace-pre-wrap font-sans"><%= m["content"] %></pre>
                    </div>
                </div>
                <% end %>

                <%= if @streaming do %>
                <div class="p-4 rounded-xl bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-700">
                    <div class="flex items-center gap-2 mb-3">
                    <span class="w-8 h-8 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M13 10V3L4 14h7v7l9-11h-7z"
                        />
                        </svg>
                    </span> <span class="text-sm font-semibold">Assistant</span>
                    <span class="px-2 py-1 text-xs rounded-full bg-indigo-900/30 text-indigo-400">
                        Streaming
                    </span>
                    </div>

                    <div class="space-y-2">
                    <pre class="whitespace-pre-wrap font-sans"><%= @stream_buffer %></pre>
                    <div class="flex space-x-1 pt-2">
                        <div class="w-2 h-2 bg-indigo-400 rounded-full animate-pulse"></div>

                        <div class="w-2 h-2 bg-indigo-400 rounded-full animate-pulse delay-150">
                        </div>

                        <div class="w-2 h-2 bg-indigo-400 rounded-full animate-pulse delay-300">
                        </div>
                    </div>
                    </div>
                </div>
                <% end %>
            </div>
            </div>
            <!-- Results Panel -->
            <%= if @result do %>
            <div class="border-t border-slate-700">
                <div class="p-5 bg-slate-900/50">
                <h4 class="font-semibold mb-4 flex items-center gap-2">
                    <svg
                    class="w-5 h-5 text-green-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                    </svg>
                    Execution Results
                </h4>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
                    <div class="bg-slate-800 rounded-lg p-4">
                    <div class="text-xs text-slate-400 uppercase tracking-wider mb-2">Run ID</div>

                    <div class="font-mono text-sm break-all flex items-center gap-2">
                        <a
                        class="text-indigo-400 hover:text-indigo-300 transition-colors truncate"
                        href={~p"/api/runs/#{@result.run_id}"}
                        target="_blank"
                        >
                        {@result.run_id}
                        </a>
                        <button class="p-1 hover:bg-slate-700 rounded transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                            />
                        </svg>
                        </button>
                    </div>
                    </div>

                    <div class="bg-slate-800 rounded-lg p-4">
                    <div class="text-xs text-slate-400 uppercase tracking-wider mb-2">
                        Trace ID
                    </div>

                    <a
                        class="font-mono text-sm break-all text-indigo-400 hover:text-indigo-300 transition-colors"
                        href={~p"/runs?trace_id=#{@result.trace_id}"}
                    >
                        {@result.trace_id}
                    </a>
                    </div>

                    <div class="bg-slate-800 rounded-lg p-4">
                    <div class="text-xs text-slate-400 uppercase tracking-wider mb-2">Status</div>

                    <div class="flex items-center gap-2">
                        <span class={status_badge_class(@result.status)}>{@result.status}</span>
                    </div>
                    </div>

                    <div class="bg-slate-800 rounded-lg p-4">
                    <div class="text-xs text-slate-400 uppercase tracking-wider mb-2">
                        Latency
                    </div>

                    <div class="flex items-center gap-2">
                        <span class="text-lg font-semibold">{@result.latency_ms}</span>
                        <span class="text-slate-400">ms</span>
                    </div>
                    </div>
                </div>

                <%= if @result.usage do %>
                    <div class="bg-slate-800 rounded-lg p-4">
                    <div class="flex items-center justify-between mb-3">
                        <div class="text-sm font-semibold">Usage Details</div>

                        <button class="text-xs text-slate-400 hover:text-slate-300">
                        Show Details
                        </button>
                    </div>

                    <div class="grid grid-cols-3 gap-4">
                        <div class="text-center">
                        <div class="text-2xl font-bold text-indigo-400">
                            {Map.get(@result.usage || %{}, "prompt_tokens") || Map.get(@result.usage || %{}, :prompt_tokens) || 0}
                        </div>

                        <div class="text-xs text-slate-400">Prompt Tokens</div>
                        </div>

                        <div class="text-center">
                        <div class="text-2xl font-bold text-purple-400">
                            {Map.get(@result.usage || %{}, "completion_tokens") || Map.get(@result.usage || %{}, :completion_tokens) || 0}
                        </div>

                        <div class="text-xs text-slate-400">Completion Tokens</div>
                        </div>

                        <div class="text-center">
                        <div class="text-2xl font-bold text-green-400">
                            {Map.get(@result.usage || %{}, "total_tokens") || Map.get(@result.usage || %{}, :total_tokens) || 0}
                        </div>

                        <div class="text-xs text-slate-400">Total Tokens</div>
                        </div>
                    </div>
                    </div>
                <% end %>
                </div>
            </div>
            <% end %>
        </div>
        </div>
    </div>
    </div>
</div>
