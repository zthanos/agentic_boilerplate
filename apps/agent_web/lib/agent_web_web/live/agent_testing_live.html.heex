<div phx-hook="LlmSSE" id="agent-testing-sse">
  <AdminLayouts.admin
    flash={@flash}
    current_page={@current_page}
    current_section={@current_section}
    sidebar_collapsed={@sidebar_collapsed}
    loading={@loading}
    error={@error}
  >
    <!-- Fill the available height that AdminLayouts.admin gives to the page -->
    <div class="h-full min-h-0 flex flex-col">
      <!-- Page Header -->
      <div class="mb-8">
        <.header>
          RAG History Chat
          <:subtitle>
            Test and validate agent behavior with RAG-powered history search
            <%= if @selected_agent_id do %>
              <span class="inline-flex items-center gap-2 ml-3">
                <div class="badge badge-primary badge-outline">
                  {get_selected_agent_name(assigns)}
                </div>
              </span>
            <% end %>
          </:subtitle>

          <:actions>
            <%= if @selected_agent_id do %>
              <button class="btn btn-outline btn-sm" phx-click="back_to_agent_selection">
                <.icon name="hero-arrow-left" class="size-4" /> Change Agent
              </button>
            <% end %>

            <button
              class="btn btn-primary btn-sm"
              phx-click="seed_agents"
              disabled={@loading}
            >
              <%= if @loading do %>
                <span class="loading loading-spinner loading-xs"></span> Seeding...
              <% else %>
                <.icon name="hero-plus" class="size-4" /> Seed Test Agents
              <% end %>
            </button>
          </:actions>
        </.header>
      </div>
      
<!-- Agent Selection Card -->
      <%= if !@selected_agent_id do %>
        <div class="flex-1 min-h-0 card bg-base-200 shadow-sm mb-6">
          <div class="card-body">
            <h2 class="card-title text-lg">Select Agent</h2>

            <%= if @available_agents == [] do %>
              <.empty_state
                title="No agents available"
                message="Seed test agents to get started with RAG history chat testing"
                icon="hero-cpu-chip"
              >
                <:actions>
                  <button class="btn btn-primary" phx-click="seed_agents" disabled={@loading}>
                    {if @loading, do: "Seeding...", else: "Seed Test Agents"}
                  </button>
                </:actions>
              </.empty_state>
            <% else %>
              <form phx-change="select_agent" class="max-w-xs">
                <div class="form-control">
                  <label class="label">
                    <span class="label-text">Choose an agent to test</span>
                  </label>
                  <select class="select select-bordered" name="agent_id">
                    <option disabled selected>Select an agent...</option>

                    <%= for agent <- @available_agents do %>
                      <option value={agent.id}>
                        {agent.name || agent.id}
                        <%= if Map.get(agent.metadata || %{}, "test_mode") do %>
                          (Test)
                        <% end %>
                      </option>
                    <% end %>
                  </select>
                </div>
              </form>
            <% end %>

            <%= if @error_info do %>
              <div class="alert alert-error mt-4">
                <.icon name="hero-exclamation-circle" class="size-5" />
                <div>
                  <div class="font-semibold">{@error_info.message}</div>
                  <%= if @error_info.recovery_actions do %>
                    <div class="mt-2 flex gap-2">
                      <%= for action <- @error_info.recovery_actions do %>
                        <button class="btn btn-sm btn-ghost" phx-click={action}>Retry</button>
                      <% end %>
                    </div>
                  <% end %>
                </div>
                <button class="btn btn-sm btn-ghost btn-circle" phx-click="clear_error">
                  <.icon name="hero-x-mark" class="size-4" />
                </button>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      
<!-- Main Testing Interface (shown when agent is selected) -->
      <%= if @selected_agent_id do %>
        <!-- IMPORTANT: no calc() height; let the parent flex container define height -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 flex-1 min-h-0">
          <!-- Workflow Visualization Card -->
          <div class="card bg-base-200 shadow-sm flex flex-col h-full min-h-0">
            <div class="card-body flex flex-col flex-1 overflow-hidden min-h-0">
              <div class="flex items-center justify-between mb-4">
                <h2 class="card-title text-lg">Workflow Visualization</h2>

                <div class="flex gap-2">
                  <button
                    class="btn btn-sm btn-outline"
                    phx-click="run_validation_tests"
                    disabled={@validation_running || @streaming}
                  >
                    <%= if @validation_running do %>
                      <span class="loading loading-spinner loading-xs"></span> Validating...
                    <% else %>
                      <.icon name="hero-beaker" class="size-4" /> Run Tests
                    <% end %>
                  </button>

                  <%= if @validation_results do %>
                    <button class="btn btn-sm btn-ghost" phx-click="clear_validation_results">
                      Clear
                    </button>
                  <% end %>
                </div>
              </div>

              <%= if @workflow_graph do %>
                <div class="bg-base-100 rounded-lg p-4 flex-1 min-h-0 overflow-hidden">
                  <.live_component
                    module={AgentWebWeb.WorkflowGraphComponent}
                    id="workflow-graph"
                    workflow_spec={@workflow_graph}
                    execution_state={@workflow_execution_state}
                    current_step={@current_step_id}
                    execution_id={@execution_id}
                    class="h-full"
                  />
                </div>
              <% else %>
                <div class="flex-1 min-h-0 flex items-center justify-center">
                  <.empty_state
                    title="No workflow loaded"
                    message="Workflow visualization will appear here once the agent is initialized"
                    icon="hero-squares-2x2"
                  />
                </div>
              <% end %>
              
<!-- Validation Results -->
              <%= if @validation_results do %>
                <div class="mt-4 flex-shrink-0 max-h-64 overflow-y-auto">
                  <div class="p-4 bg-base-100 rounded-lg border border-base-300">
                    <div class="flex items-center justify-between mb-3">
                      <h3 class="font-semibold flex items-center gap-2">
                        <.icon name="hero-beaker" class="size-5" /> Validation Results
                      </h3>

                      <%= if @validation_results.passed == @validation_results.total_tests do %>
                        <span class="badge badge-success">All Passed</span>
                      <% else %>
                        <span class="badge badge-error">
                          {@validation_results.failed} Failed
                        </span>
                      <% end %>
                    </div>

                    <div class="text-sm text-base-content/70 mb-3">
                      {@validation_results.passed}/{@validation_results.total_tests} tests passed
                      in {@validation_results.execution_time_ms}ms
                    </div>

                    <div class="space-y-2">
                      <%= for result <- @validation_results.results do %>
                        <div class={[
                          "p-3 rounded-lg border-l-4",
                          if(result.status == :passed,
                            do: "bg-success/10 border-success",
                            else: "bg-error/10 border-error"
                          )
                        ]}>
                          <div class="flex items-center gap-2 mb-1">
                            <%= if result.status == :passed do %>
                              <.icon name="hero-check-circle" class="size-4 text-success" />
                            <% else %>
                              <.icon name="hero-x-circle" class="size-4 text-error" />
                            <% end %>
                            <span class="font-medium text-sm">{result.test_name}</span>
                            <span class="text-xs text-base-content/50">
                              ({result.execution_time_ms}ms)
                            </span>
                          </div>

                          <div class="text-xs text-base-content/70">{result.details}</div>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
          
<!-- Chat Interface Card -->
          <div class="card bg-base-200 shadow-sm flex flex-col h-full min-h-0">
            <div class="card-body flex flex-col flex-1 overflow-hidden min-h-0">
              <h2 class="card-title text-lg mb-4 flex-shrink-0">Chat Interface</h2>
              
<!-- Chat Container -->
              <div class="bg-base-100 rounded-lg border border-base-300 flex flex-col flex-1 min-h-0 overflow-hidden">
                <!-- Messages Area -->
                <div
                  class="flex-1 overflow-y-auto p-4 min-h-0"
                  phx-hook="AutoScroll"
                  id="chat-messages"
                >
                  <%= if @chat_messages == [] do %>
                    <div class="h-full flex items-center justify-center">
                      <.empty_state
                        title="Start Testing"
                        message="Send a message to begin testing the agent with RAG history"
                        icon="hero-chat-bubble-left-right"
                      />
                    </div>
                  <% else %>
                    <.messages
                      messages={@chat_messages}
                      streaming={@streaming}
                      stream_buffer={@stream_buffer}
                      conversation_id={generate_conversation_id(@selected_agent_id)}
                    />
                  <% end %>
                </div>
                
<!-- Message Input -->
                <div class="border-t border-base-300 p-4 flex-shrink-0">
                  <form phx-submit="send_chat_message" class="flex gap-2">
                    <input
                      type="text"
                      name="message"
                      placeholder="Type your test message..."
                      class="input input-bordered flex-1"
                      disabled={@streaming || !@selected_agent_id}
                      autocomplete="off"
                    />
                    <button
                      type="submit"
                      class="btn btn-primary"
                      disabled={@streaming || !@selected_agent_id}
                    >
                      <%= if @streaming do %>
                        <span class="loading loading-spinner loading-xs"></span>
                      <% else %>
                        <.icon name="hero-paper-airplane" class="size-4" />
                      <% end %>
                      Send
                    </button>
                  </form>

                  <%= if @error_info do %>
                    <div class="alert alert-error mt-2">
                      <.icon name="hero-exclamation-circle" class="size-5" />
                      <div class="text-sm">
                        {@error_info.message}
                      </div>
                      <button class="btn btn-sm btn-ghost" phx-click="clear_error">
                        <.icon name="hero-x-mark" class="size-4" />
                      </button>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </AdminLayouts.admin>
</div>
