<div
  phx-hook="LlmSSE"
  id="agent-testing-sse"
  class="h-screen flex flex-col bg-base-100 overflow-hidden"
>
  <!-- Enhanced Header -->
  <header class="h-16 border-b border-base-300 bg-base-100 px-6 flex items-center justify-between shrink-0 shadow-sm">
    <div class="flex items-center gap-8">
      <!-- Logo/Brand Section -->
      <div class="flex items-center gap-4">
        <div class="w-8 h-8 bg-gradient-to-br from-primary to-primary-focus rounded-lg flex items-center justify-center shadow">
          <span class="text-white font-bold text-xs">AL</span>
  
        
        <div class="flex flex-col justify-center">
          <h1 class="text-xs font-semibold tracking-wide uppercase text-base-content/70 leading-none">
            Agent Lab
          </h1>
          
          <p class="text-base font-bold leading-tight text-base-content">Testing Interface</p>
        </div>
      </div>
      
      <div class="h-8 w-px bg-base-300"></div>
      <!-- Agent Selection -->
      <form phx-change="select_agent" class="flex items-center gap-3">
        <span class="text-xs font-semibold uppercase tracking-wide text-base-content/60">
          Active Agent
        </span>
        <select
          name="agent_id"
          class="select select-sm select-bordered bg-base-100 border-base-300 font-medium text-sm w-72 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all duration-200"
        >
          <option disabled selected={@selected_agent_id == nil} class="text-base-content/40">
            Select agent...
          </option>
          
          <%= for agent <- @available_agents do %>
            <option value={agent.id} selected={@selected_agent_id == agent.id}>
              {agent.name || agent.id}
            </option>
          <% end %>
        </select>
      </form>
    </div>
    <!-- Status Indicators -->
    <div class="flex items-center gap-4">
      <div class="badge badge-outline badge-sm font-medium border-base-300 text-xs px-3 py-2">
        <span class="w-2 h-2 rounded-full bg-success mr-2"></span> {@selected_agent_id ||
          "no-session"}
      </div>
      
      <div class="text-xs font-medium text-base-content/40 px-3 py-1.5 bg-base-200 rounded-lg">
        v1.8.3 • Stable
      </div>
    </div>
  </header>
  <!-- Main Content Area -->
  <main class="flex-1 flex overflow-hidden bg-base-200/50">
    <%= if @selected_agent_id do %>
      <!-- Left Panel - Workflow Engine -->
      <section class="flex-1 flex flex-col min-w-0 border-r border-base-300 bg-white shadow-inner">
        <!-- Panel Header -->
        <div class="px-6 py-3 flex items-center justify-between border-b border-base-300 bg-gradient-to-r from-base-100 to-base-50">
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse shadow-sm"></span>
              <h2 class="text-xs font-bold uppercase tracking-wider text-base-content">
                Workflow Engine
              </h2>
            </div>
            
            <div class="text-xs font-medium text-base-content/50 px-2 py-1 bg-base-200 rounded">
              Real-time
            </div>
          </div>
          
          <button
            class="btn btn-sm btn-primary shadow-sm hover:shadow transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
            phx-click="run_validation_tests"
            disabled={@validation_running || @streaming}
          >
            <%= if @validation_running do %>
              <span class="loading loading-spinner loading-xs mr-2"></span> Running...
            <% else %>
              Run Test Suite
            <% end %>
          </button>
        </div>
        <!-- Graph Visualization Area -->
        <div class="flex-1 relative min-h-0 bg-gradient-to-b from-base-50 to-base-100/50">
          <%= if @workflow_graph do %>
            <.live_component
              module={AgentWebWeb.WorkflowGraphComponent}
              id="workflow-graph"
              workflow_spec={@workflow_graph}
              execution_state={@workflow_execution_state}
              current_step={@execution_status.current_step_name}
              class="absolute inset-0 w-full h-full"
            />
          <% else %>
            <div class="h-full flex flex-col items-center justify-center text-base-content/40">
              <div class="w-12 h-12 mb-4">
                <div class="w-full h-full border-4 border-dashed border-base-300 rounded-xl animate-pulse">
                </div>
              </div>
              
              <p class="text-sm font-medium">Initializing workflow visualization...</p>
              
              <p class="text-xs mt-1">Loading agent specifications</p>
            </div>
          <% end %>
        </div>
        <!-- Test Results Panel -->
        <%= if @validation_results do %>
          <div class="h-56 border-t border-base-300 bg-white overflow-hidden flex flex-col">
            <div class="px-6 py-3 border-b border-base-300 bg-base-50 flex items-center justify-between">
              <p class="text-xs font-bold uppercase tracking-wide text-base-content">Test Logs</p>
              
              <div class="flex items-center gap-2">
                <span class="text-xs font-medium text-base-content/60">
                  {length(@validation_results.results)} tests
                </span>
                <span class={[
                  "badge badge-sm",
                  if(@validation_results.status == :passed,
                    do: "badge-success",
                    else: "badge-error"
                  )
                ]}>
                  {@validation_results.status}
                </span>
              </div>
            </div>
            
            <div class="flex-1 overflow-y-auto p-4 space-y-3">
              <%= for result <- @validation_results.results do %>
                <div class="flex items-start gap-3 p-3 rounded-lg hover:bg-base-100 transition-colors duration-150">
                  <div class={[
                    "w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold",
                    if(result.status == :passed,
                      do: "bg-success/20 text-success",
                      else: "bg-error/20 text-error"
                    )
                  ]}>
                    {if result.status == :passed, do: "✓", else: "✗"}
                  </div>
                  
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-base-content">{result.test_name}</p>
                    
                    <p class="text-xs text-base-content/60 mt-1">
                      {result.description || "No description"}
                    </p>
                  </div>
                  
                  <div class="text-xs font-mono text-base-content/40 bg-base-200 px-2 py-1 rounded">
                    {result.execution_time_ms}ms
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>
      <!-- Right Panel - Interactive Session -->
      <section class="w-[420px] xl:w-[500px] flex flex-col bg-white border-l border-base-300 shadow-lg shrink-0">
        <!-- Session Header -->
        <div class="px-6 py-3 border-b border-base-300 bg-gradient-to-r from-base-100 to-base-50 flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-base-content">
            Interactive Session
          </span>
          <div :if={@streaming} class="flex items-center gap-2">
            <div class="badge badge-primary badge-sm font-medium px-3 py-2 shadow-sm">
              <span class="loading loading-spinner loading-xs mr-2"></span> STREAMING
            </div>
          </div>
        </div>
        <!-- Chat Messages Area -->
        <div class="flex-1 overflow-y-auto p-4 bg-gradient-to-b from-base-50/50 to-transparent">
          <.messages
            messages={@chat_messages}
            streaming={@streaming}
            stream_buffer={@stream_buffer}
            conversation_id={generate_conversation_id(@selected_agent_id)}
          />
        </div>
        <!-- Input Panel -->
        <div class="p-6 border-t border-base-300 bg-white space-y-4">
          <!-- Execution Status Bar -->
          <div class="px-4 py-3 flex items-center justify-between bg-base-100 border border-base-300 rounded-lg shadow-sm">
            <div class="flex items-center gap-3 overflow-hidden">
              <div class={[
                "w-3 h-3 rounded-full",
                if(@execution_status.status == :running,
                  do: "bg-warning animate-pulse",
                  else: "bg-success"
                )
              ]}>
              </div>
              
              <div class="min-w-0">
                <p class="text-xs font-semibold text-base-content truncate">
                  {if @execution_status.current_step_name,
                    do: "Executing: #{@execution_status.current_step_name}",
                    else: "System Ready"}
                </p>
                
                <p class="text-[10px] text-base-content/50 mt-0.5">Agent processing pipeline</p>
              </div>
            </div>
            
            <div class="flex items-center gap-2">
              <span class="text-xs font-medium text-base-content/70">
                {@execution_status.completed_steps}/{@execution_status.total_steps}
              </span>
              <div class="w-16 bg-base-300 rounded-full h-1.5">
                <div
                  class="bg-primary h-1.5 rounded-full transition-all duration-300"
                  style={"width: #{(@execution_status.completed_steps / max(@execution_status.total_steps, 1)) * 100}%"}
                >
                </div>
              </div>
            </div>
          </div>
          <!-- Input Form -->
          <form phx-submit="send_chat_message" class="relative">
            <input
              type="text"
              name="message"
              placeholder="Type command or query..."
              class="input input-bordered w-full pr-24 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all duration-200 text-sm py-3"
              disabled={@streaming || !@selected_agent_id}
            />
            <button
              type="submit"
              class="btn btn-primary absolute right-1.5 top-1.5 shadow-sm hover:shadow disabled:opacity-50 disabled:cursor-not-allowed"
              disabled={@streaming || !@selected_agent_id}
            >
              <span class="font-medium">Execute</span>
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"
                />
              </svg>
            </button>
          </form>
          <!-- Footer Actions -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>
              <span class="text-xs font-medium text-success">Connected</span>
            </div>
            
            <button
              phx-click="clear_chat"
              class="text-xs font-medium text-base-content/60 hover:text-base-content transition-colors duration-200 flex items-center gap-1"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                />
              </svg>
              Clear Logs
            </button>
          </div>
        </div>
      </section>
    <% else %>
      <!-- Empty State -->
      <div class="flex-1 flex flex-col items-center justify-center">
        <div class="w-20 h-20 border-2 border-dashed border-base-300 rounded-2xl mb-6 flex items-center justify-center">
          <svg
            class="w-10 h-10 text-base-content/30"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
            />
          </svg>
        </div>
        
        <h3 class="text-lg font-semibold text-base-content mb-2">No Agent Selected</h3>
        
        <p class="text-sm text-base-content/60 max-w-md text-center mb-6">
          Select an agent from the dropdown above to initialize the testing environment and begin workflow execution.
        </p>
        
        <div class="text-xs font-medium text-base-content/40 px-4 py-2 bg-base-200 rounded-lg">
          Available agents: {length(@available_agents)}
        </div>
      </div>
    <% end %>
  </main>
  <!-- Error Display -->
  <div :if={@error_info} class="fixed bottom-6 left-6 w-96 z-50">
    <.live_component
      module={AgentWebWeb.ErrorDisplayComponent}
      id="global-error"
      error={@error_info.message}
      error_type={@error_info.type}
      context={@error_info.context}
      recovery_actions={@error_info.recovery_actions}
      dismissible={true}
    />
  </div>
</div>
      module={AgentWebWeb.ErrorDisplayComponent}
      id="global-error"
      error={@error_info.message}
      error_type={@error_info.type}
      context={@error_info.context}
      recovery_actions={@error_info.recovery_actions}
      dismissible={true}
    />
  </div>
</div>v>={AgentWebWeb.ErrorDisplayComponent}
      id="global-error"
      error={@error_info.message}
      error_type={@error_info.type}
      context={@error_info.context}
      recovery_actions={@error_info.recovery_actions}
      dismissible={true}
    />
  </div>
</div>